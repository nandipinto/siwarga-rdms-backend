meta {
  name: Import Payments CSV
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/payments/import
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(/Users/nandipinto/Downloads/Playground/Carissa/Siwarga/payments-2026-import.csv) @contentType(text/csv)
}

docs {
  POST /api/v1/payments/import — Bulk import from CSV/TXT. Administrator only. Returns 202.
  
  Column order: block_code, house_number, payment_date, gross_amount, note
  Delimiter: comma or semicolon (auto-detected). UTF-8. Optional header row.
}
