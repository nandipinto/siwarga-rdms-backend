docs {
  GET /api/v1/reports/arrears/{houseId} — Arrears and penalty detail for one house. Administrator and Supervisor.

  Returns totalArrearsIdr, totalPenaltiesIdr, depositIdr, unpaidPeriods, and penalties.
}
