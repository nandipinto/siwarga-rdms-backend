meta {
  name: Siwarga RDMS API
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  Resident Dues Management System (RDMS) REST API.

  Base path: /api/v1
  Auth: Bearer JWT (run Auth > Login first).

  Roles:
  - ADMINISTRATOR — full access
  - SUPERVISOR — dues payments, rental-guarantee receipts/refunds, and reports only

  Endpoints:
  - Auth: POST /auth/login
  - RWs: GET/POST /rws, GET/PUT/DELETE /rws/{id}
  - RTs: GET/POST /rts, GET/PUT/DELETE /rts/{id} (rwId required on create/update; optional rwId filter on list)
  - Houses: GET/POST /houses, GET/PUT /houses/{id}, POST /houses/import (no DELETE)
  - Users: GET/POST /users, GET/PUT/DELETE /users/{id}
  - Payments: GET/POST /payments, GET/PUT/DELETE /payments/{id}, POST /payments/import
  - Rental Guarantee: GET/POST /rental-guarantee/payments, GET/PUT/DELETE /rental-guarantee/payments/{id},
    POST /rental-guarantee/payments/import, GET /rental-guarantee/refunds,
    GET /rental-guarantee/refunds/{id}, POST /rental-guarantee/refunds/{id}/complete,
    DELETE /rental-guarantee/refunds/{id}
  - Reports: GET /reports/dues/monthly, GET /reports/arrears/{houseId}
}
