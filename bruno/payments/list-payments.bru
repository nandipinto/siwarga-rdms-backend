meta {
  name: List Payments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/payments
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 20
}

docs {
  GET /api/v1/payments — List all payments (paginated). Administrator and Supervisor.
  Pagination: page (0-based), size (default 20).
  See also: List Payments by House / RT / Date Range.
}
