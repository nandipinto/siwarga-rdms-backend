meta {
  name: Create Guarantee Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/rental-guarantee/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "houseId": "{{houseId}}",
    "paymentDate": "2026-06-09",
    "amountIdr": 300000,
    "note": "Transfer BCA"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("guaranteePaymentId", body.id, { persist: true });
  }
}

docs {
  POST /api/v1/rental-guarantee/payments — Record guarantee-fee collection. Returns receipt with receiptNumber (RG-…).
  amountIdr must equal house rentalGuaranteeAmountIdr exactly. One receipt per obligation cycle.
  paidByName/Email/Phone snapshotted from current tenant. Administrator and Supervisor.
}
