meta {
  name: Create RW
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/rws
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rwCode": "RW_14",
    "description": "RW 14"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("rwId", body.id, { persist: true });
  }
}

docs {
  POST /api/v1/rws — Create a new RW. Administrator only. Saves rwId to environment.
}
