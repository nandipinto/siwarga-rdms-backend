meta {
  name: Create RT
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/rts
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rwId": "{{rwId}}",
    "rtCode": "RT03",
    "description": "RT 03"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("rtId", body.id, { persist: true });
  }
}

docs {
  POST /api/v1/rts — Create a new RT under an RW. Administrator only. Requires rwId. Saves rtId to environment.
}
