meta {
  name: Create House
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/houses
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rtId": "{{rtId}}",
    "blockCode": "E",
    "houseNumber": "20",
    "ownerName": "Budi Santoso",
    "email": "budi@example.com",
    "phone": "081234567890",
    "activeDate": "2024-01-01",
    "status": "OWNED"
  }
}

vars:pre-request {
  rtId: 381d0324-5e34-4b51-8e47-193ad3a87225
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("houseId", body.id, { persist: true });
  }
}

docs {
  POST /api/v1/houses — Create a new house. Administrator only. Saves houseId to environment.
  activeDate defaults to 2024-01-01 if omitted. status defaults to OWNED if omitted.
}
