meta {
  name: List Payments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/payments
  body: none
  auth: inherit
}

params:query {
  ~houseId: {{houseId}}
  ~rtId: {{rtId}}
  ~from: 2024-01-01
  ~to: 2026-12-31
  page: 0
  size: 20
}

docs {
  GET /api/v1/payments — List payments (paginated). Administrator and Supervisor.

  Optional filters: houseId, rtId, from, to (ISO dates).
  Pagination: page (0-based), size (default 20).
}
