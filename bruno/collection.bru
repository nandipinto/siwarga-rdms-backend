meta {
  name: Siwarga RDMS API
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  Resident Dues Management System (RDMS) REST API.

  Base path: /api/v1
  Auth: Bearer JWT (run Auth > Login first).

  Roles:
  - ADMINISTRATOR — full access
  - SUPERVISOR — payments and reports only

  Endpoints:
  - Auth: POST /auth/login
  - RTs: GET/POST /rts, GET/PUT/DELETE /rts/{id}
  - Houses: GET/POST /houses, GET/PUT /houses/{id}, POST /houses/import (no DELETE)
  - Users: GET/POST /users, GET/PUT/DELETE /users/{id}
  - Payments: GET/POST /payments, GET/PUT/DELETE /payments/{id}, POST /payments/import
  - Reports: GET /reports/dues/monthly, GET /reports/arrears/{houseId}
}
