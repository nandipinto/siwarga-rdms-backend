meta {
  name: Create House
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/houses
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rtId": "{{rtId}}",
    "blockCode": "L",
    "houseNumber": "01",
    "ownerName": "White Snake",
    "email": "whitesnake@example.com",
    "phone": "081234567999",
    "activeDate": "2024-01-01",
    "status": "OWNED"
  }
}

vars:pre-request {
  rtId: e7d63230-b298-4850-bf42-03867e1ce8f2
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("houseId", body.id, { persist: true });
  }
}

docs {
  POST /api/v1/houses — Create a new house. Administrator only. Saves houseId to environment.
  activeDate defaults to 2024-01-01 if omitted. status defaults to OWNED if omitted.
}
